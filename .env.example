# Copiar a .env.local y completar con el proyecto Supabase del cliente (cuenta vivitravelsmail@gmail.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta de Supabase (service_role) — solo para uso server-side, nunca al cliente
# Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para el cron endpoint de Vercel (cualquier string random largo)
# Configurar también en Vercel > Project > Settings > Environment Variables
CRON_SECRET=

# URL pública del sitio (sin barra final) — usada en sitemap, schema.org y OpenGraph
NEXT_PUBLIC_SITE_URL=https://vivitravel.vercel.app
