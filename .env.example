# Copiar a .env.local y completar con el proyecto Supabase del cliente (cuenta vivitravelsmail@gmail.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta de Supabase (service_role) — solo para uso server-side, nunca al cliente
# Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para el cron endpoint de Vercel (cualquier string random largo)
# Configurar también en Vercel > Project > Settings > Environment Variables
CRON_SECRET=

# URL pública del sitio (sin barra final) — usada en sitemap, schema.org y OpenGraph
NEXT_PUBLIC_SITE_URL=https://vivitravel.vercel.app

# ID de Google Analytics 4 (ej: G-XXXXXXXXXX) — opcional; si no se define no se carga
NEXT_PUBLIC_GA_ID=

# Token público de Mapbox para los mapas (mapbox.com > Account > Access tokens)
# Pedir a Bruno: necesita el token del proyecto del cliente
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend — envío de mails transaccionales (resend.com)
# Crear cuenta, agregar dominio vivitravels.com.ar y generar API key
RESEND_API_KEY=
RESEND_FROM=Vivitravels <noreply@vivitravels.com.ar>
